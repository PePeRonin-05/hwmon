{
  "__inputs": [],
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "type": "row",
      "title": "Обзор за период (все диски авто)",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false,
      "id": 300
    },
    {
      "type": "stat",
      "title": "SMART Status (1=OK)",
      "datasource": {
        "type": "prometheus",
        "uid": null
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "FAIL",
                  "color": "red"
                },
                "1": {
                  "text": "OK",
                  "color": "green"
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "expr": "smartctl_device_smart_status{device=~\"$disk\"}",
          "legendFormat": "{{device}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Температура (макс за период)",
      "datasource": {
        "type": "prometheus",
        "uid": null
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 60
              },
              {
                "color": "red",
                "value": 70
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "max"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "expr": "max(smartctl_device_temperature{device=~\"$disk\"})",
          "legendFormat": "max",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Наработка (ч)",
      "datasource": {
        "type": "prometheus",
        "uid": null
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "h",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "expr": "smartctl_device_power_on_seconds{device=~\"$disk\"} / 3600",
          "legendFormat": "{{device}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Ошибки лога",
      "datasource": {
        "type": "prometheus",
        "uid": null
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "expr": "smartctl_device_error_log_count{device=~\"$disk\"}",
          "legendFormat": "{{device}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Температура дисков — за период",
      "datasource": {
        "type": "prometheus",
        "uid": null
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "custom": {
            "fillOpacity": 25,
            "lineWidth": 3
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 60
              },
              {
                "color": "red",
                "value": 70
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "min",
            "max",
            "mean"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "smartctl_device_temperature{device=~\"$disk\"}",
          "legendFormat": "{{device}}",
          "refId": "A"
        }
      ],
      "description": "Максимум и цветовая норма (>60 жёлтый, >70 красный). Рост к критике = риск деградации / плохое охлаждение."
    },
    {
      "type": "timeseries",
      "title": "Износ / перезапись (SSD wear & HDD health)",
      "datasource": {
        "type": "prometheus",
        "uid": null
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "description": "Автоподхватывает атрибуты износа: SSD (Host_Writes, Wear, Percent_Lifetime) и HDD (Reallocated, Total_LBAs). Нет атрибута на диске — просто не рисуется.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "min",
            "max",
            "mean"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "smartctl_device_attribute{device=~\"$disk\", attribute_name=~\"Host_Writes_GiB|Total_Host_Writes|Wear_Leveling_Count|Media_Wearout_Indicator|Percent_Lifetime_Remain|Percent_Lifetime_Used\", attribute_value_type=\"raw\"}",
          "legendFormat": "{{device}} {{attribute_name}}",
          "refId": "A"
        },
        {
          "expr": "smartctl_device_attribute{device=~\"$disk\", attribute_name=~\"Reallocated_Sector_Ct|Current_Pending_Sector|Reallocated_Event_Count|Total_LBAs_Written|Total_LBAs_Read\", attribute_value_type=\"raw\"}",
          "legendFormat": "{{device}} {{attribute_name}}",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Здоровье и ошибки (по времени)",
      "datasource": {
        "type": "prometheus",
        "uid": null
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "min",
            "max",
            "mean"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "smartctl_device_error_log_count{device=~\"$disk\"}",
          "legendFormat": "{{device}} error",
          "refId": "A"
        },
        {
          "expr": "smartctl_device_smart_status{device=~\"$disk\"}",
          "legendFormat": "{{device}} status",
          "refId": "B"
        }
      ],
      "description": "error_log растёт = диск деградирует. status падает в 0 = SMART FAIL."
    },
    {
      "type": "row",
      "title": "Таблицы атрибутов (авто по диску)",
      "collapsed": true,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 23
      },
      "panels": [
        {
          "type": "table",
          "title": "Инфо о дисках",
          "datasource": {
            "type": "prometheus",
            "uid": null
          },
          "gridPos": {
            "h": 7,
            "w": 24,
            "x": 0,
            "y": 24
          },
          "fieldConfig": {
            "defaults": {},
            "overrides": []
          },
          "options": {
            "showHeader": true
          },
          "targets": [
            {
              "expr": "smartctl_device{device=~\"$disk\"}",
              "format": "table",
              "instant": true,
              "refId": "A"
            }
          ],
          "transformations": [
            {
              "id": "organize",
              "options": {
                "excludeByName": {
                  "Time": true,
                  "__name__": true,
                  "instance": true,
                  "job": true
                }
              }
            }
          ]
        },
        {
          "type": "table",
          "title": "Все S.M.A.R.T атрибуты (нормированные)",
          "datasource": {
            "type": "prometheus",
            "uid": null
          },
          "gridPos": {
            "h": 9,
            "w": 24,
            "x": 0,
            "y": 31
          },
          "fieldConfig": {
            "defaults": {},
            "overrides": []
          },
          "options": {
            "showHeader": true,
            "sortBy": [
              {
                "displayName": "Атрибут",
                "desc": false
              }
            ]
          },
          "targets": [
            {
              "expr": "smartctl_device_attribute{device=~\"$disk\", attribute_value_type=\"value\"}",
              "format": "table",
              "instant": true,
              "refId": "A"
            }
          ],
          "transformations": [
            {
              "id": "organize",
              "options": {
                "renameByName": {
                  "attribute_id": "Attr#",
                  "attribute_name": "Атрибут",
                  "device": "Диск",
                  "Value": "Норма"
                },
                "excludeByName": {
                  "Time": false,
                  "__name__": true,
                  "instance": true,
                  "job": true,
                  "attribute_flags_long": true,
                  "attribute_flags_short": true,
                  "attribute_value_type": true
                }
              }
            }
          ]
        },
        {
          "type": "table",
          "title": "Все S.M.A.R.T атрибуты (raw)",
          "datasource": {
            "type": "prometheus",
            "uid": null
          },
          "gridPos": {
            "h": 9,
            "w": 24,
            "x": 0,
            "y": 40
          },
          "fieldConfig": {
            "defaults": {},
            "overrides": []
          },
          "options": {
            "showHeader": true
          },
          "targets": [
            {
              "expr": "smartctl_device_attribute{device=~\"$disk\", attribute_value_type=\"raw\"}",
              "format": "table",
              "instant": true,
              "refId": "A"
            }
          ],
          "transformations": [
            {
              "id": "organize",
              "options": {
                "renameByName": {
                  "attribute_name": "Атрибут",
                  "device": "Диск",
                  "Value": "Raw"
                },
                "excludeByName": {
                  "Time": false,
                  "__name__": true,
                  "instance": true,
                  "job": true,
                  "attribute_flags_long": true,
                  "attribute_flags_short": true,
                  "attribute_value_type": true
                }
              }
            }
          ]
        }
      ]
    },
    {
      "type": "stat",
      "title": "Запас до крит. темп (70°C)",
      "datasource": {
        "type": "prometheus",
        "uid": null
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "description": "70°C − макс темп диска. Приближение к 0 = жарко.",
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "unit": "celsius",
          "color": {
            "mode": "background"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "expr": "70 - max(smartctl_device_temperature{device=~\".*\"})",
          "legendFormat": "v",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "15s",
  "schemaVersion": 39,
  "style": "dark",
  "tags": [
    "hardware",
    "smart"
  ],
  "templating": {
    "list": [
      {
        "name": "disk",
        "type": "custom",
        "label": "Диск (по умолч. все)",
        "query": ".*",
        "options": [
          {
            "selected": true,
            "text": "Все",
            "value": ".*"
          }
        ],
        "current": {
          "text": "Все",
          "value": ".*"
        },
        "hide": 2
      }
    ]
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "15s",
      "30s",
      "1m",
      "5m",
      "15m",
      "30m",
      "1h"
    ]
  },
  "timezone": "",
  "title": "SMART Full Drive Health",
  "uid": "smart-full",
  "version": 3
}