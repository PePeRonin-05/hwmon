        "type": "prometheus",
        "uid": null
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "description": "Сумма мощности по всем каналам IPMI. Провал до ~0 = отвал PSU/сброс; плато = пик потребления.",
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 2,
            "spanNulls": true,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
