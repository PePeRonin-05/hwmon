        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "min",
            "max",
            "mean"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum(ipmi_power_watts{name=~\"$power_group\"})",
          "legendFormat": "Σ Pwr (Вт)",
          "refId": "A"
        }
      ]
    },
